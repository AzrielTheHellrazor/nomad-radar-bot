# Zorunlu: Telegram @BotFather'dan alacağınız Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# İsteğe Bağlı: Bot açılır açılmaz otomatik bildirim göndereceği kendi Telegram Chat ID'niz
TELEGRAM_CHAT_ID=0

# İsteğe Bağlı (Önerilen): Google AI Studio Gemini API Anahtarı (Ücretsiz tier destekler)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# İsteğe Bağlı: Kiwi Tequila Ücretsiz Uçuş API Anahtarı (https://tequila.kiwi.com/)
TEQUILA_API_KEY=

# Tarama sıklığı (dakika)
SCAN_INTERVAL_MINUTES=30
