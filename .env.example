# Zorunlu: Telegram @BotFather'dan alacağınız Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# İsteğe Bağlı: Bot açılır açılmaz otomatik bildirim göndereceği kendi Telegram Chat ID'niz
TELEGRAM_CHAT_ID=0

# İsteğe Bağlı (Önerilen): Google AI Studio Gemini API Anahtarı veya OpenRouter Anahtarı
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# İsteğe Bağlı: Anahtarsız Canlı Google Flights (fast-flights) & Ryanair HTTP Sorgusu (1=Açık, 0=Hızlı Kalibre Mod)
LIVE_FLIGHTS_HTTP=1
LIVE_RYANAIR_HTTP=1

# İsteğe Bağlı: Kiwi Tequila Ücretsiz Uçuş API Anahtarı (https://tequila.kiwi.com/)
TEQUILA_API_KEY=

# İsteğe Bağlı: SerpApi Google Flights API Anahtarı
SERPAPI_API_KEY=

# İsteğe Bağlı: Travelpayouts / Aviasales Uçuş Veri API Token
TRAVELPAYOUTS_TOKEN=

# Tarama sıklığı (dakika)
SCAN_INTERVAL_MINUTES=30
